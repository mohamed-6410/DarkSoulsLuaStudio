<Window x:Class="DS1LuaStudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DS1LuaStudio.App.ViewModels"
        xmlns:av="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Dark Souls Lua Studio" Height="760" Width="1340" MinHeight="560" MinWidth="940"
        Loaded="OnWindowLoaded"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ========================= Lua script editor ========================= -->
        <DataTemplate DataType="{x:Type vm:LuaEditorViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Detail}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding GoalLinkSummary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GoalLinkSummary}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushSuccess}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Reload" Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.ReloadFromBytecodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>

                        <!-- Jumps to this script's own row in the goal table beside it. -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                    Margin="0,5,0,0" Orientation="Horizontal"
                                    Visibility="{Binding HasGoalLink, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GOAL" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" />
                            <Button Style="{StaticResource LinkButton}"
                                    Content="{Binding GoalLink.Display}"
                                    ToolTip="{Binding GoalLink.ToolTip}"
                                    Command="{Binding DataContext.RevealScriptGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <av:TextEditor x:Name="ScriptEditor"
                              Grid.Row="1"
                              Loaded="OnEditorLoaded"
                              Unloaded="OnEditorUnloaded"
                              ShowLineNumbers="True"
                              FontFamily="Cascadia Mono, Consolas, Courier New"
                              FontSize="13"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource EditorBackground}"
                              Foreground="{DynamicResource EditorForeground}"
                              LineNumbersForeground="{DynamicResource EditorLineNumbers}"
                              BorderThickness="0"
                              Padding="10,6" FlowDirection="LeftToRight">
                    <av:TextEditor.ContextMenu>
                        <ContextMenu FlowDirection="LeftToRight">
                            <MenuItem Header="Copy whole function" Click="OnCopyFunction" />
                            <MenuItem Header="Save function as draft..." Click="OnSaveFunctionDraft" />
                            <MenuItem Header="Drafts and templates..." Click="OnScriptLibrary" />
                            <Separator />
                            <MenuItem Header="Collapse all functions" Click="OnCollapseFunctions" />
                            <MenuItem Header="Expand all functions" Click="OnExpandFunctions" />
                        </ContextMenu>
                    </av:TextEditor.ContextMenu>
                </av:TextEditor>
            </Grid>
        </DataTemplate>

        <!-- ========================= AI goal table ========================= -->
        <DataTemplate DataType="{x:Type vm:LuaInfoViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <WrapPanel>
                        <Button Content="Add goal" Style="{StaticResource AccentButton}"
                                Command="{Binding DataContext.AddGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Add battle+logic pair" Margin="6,0,0,0"
                                ToolTip="DS1 runs a battle script and a logic script together for one enemy, so both goals share a single ID"
                                Command="{Binding DataContext.AddGoalPairCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Duplicate" Margin="6,0,0,0"
                                Command="{Binding DataContext.DuplicateGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Delete" Margin="6,0,0,0"
                                Command="{Binding DataContext.DeleteGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Border Width="1" Margin="10,2" Background="{StaticResource BrushBorderSubtle}" />
                        <Button Content="Move up" Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.MoveGoalUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Move down" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                Command="{Binding DataContext.MoveGoalDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Sort by ID" Margin="6,0,0,0"
                                Command="{Binding DataContext.SortGoalsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Border Width="1" Margin="10,2" Background="{StaticResource BrushBorderSubtle}" />
                        <Button Content="Check" Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.ValidateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Import" Margin="6,0,0,0"
                                Command="{Binding DataContext.ImportGoalsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Export" Margin="6,0,0,0"
                                Command="{Binding DataContext.ExportGoalsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <!-- Labelled, because the wrap panel puts this on its own line once the
                             buttons overflow, where an unlabelled box reads as a stray control. -->
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBox Width="190" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="Filter goals by ID, name or interrupt function" />
                    </WrapPanel>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding View}" Margin="0"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          SelectionChanged="OnGoalSelectionChanged"
                          HorizontalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="42" IsReadOnly="True" />
                        <DataGridTextColumn Header="Goal ID" Binding="{Binding Id}" Width="96" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                        <DataGridCheckBoxColumn Header="Battle" Binding="{Binding BattleInterrupt}" Width="58" />
                        <DataGridCheckBoxColumn Header="Logic" Binding="{Binding LogicInterrupt}" Width="56" />
                        <DataGridTextColumn Header="Interrupt function" Binding="{Binding LogicInterruptName}" Width="190" MinWidth="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                        Padding="10,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IssueSummary}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="{Binding IssueSummaryDetail}" Margin="12,0,0,0"
                                       Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" />
                        </StackPanel>
                        <TextBlock Text="{Binding FilterText}" Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="11.5" Margin="0,2,0,0" />
                        <ItemsControl ItemsSource="{Binding Issues}" MaxHeight="86" Margin="0,6,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ========================= Archive browser ========================= -->
        <DataTemplate DataType="{x:Type vm:ArchiveViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <WrapPanel>
                        <TextBlock Text="{Binding Detail}" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <Button Content="Open selected entry" Style="{StaticResource AccentButton}"
                                Margin="14,0,0,0"
                                Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Extract all scripts to folder..." Margin="6,0,0,0"
                                Command="{Binding DataContext.ExtractAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </WrapPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontSize="10.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <!-- Text must be set by the style, otherwise the
                                                     local value would beat the data trigger. -->
                                                <Setter Property="Text" Value="Lua" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksLikeLua}" Value="False">
                                                        <Setter Property="Text" Value="" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               FontSize="10.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="goal table" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksLikeLuaInfo}" Value="False">
                                                        <Setter Property="Text" Value="" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Size, StringFormat={}{0:N0} B}"
                                           Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <!-- ========================= Globals list ========================= -->
        <DataTemplate DataType="{x:Type vm:LuaGnlViewModel}">
            <Grid Margin="10">
                <TextBox Text="{Binding GlobalsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="False"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <!-- ========================= Empty state ========================= -->
        <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- ===================== Menu ===================== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open file..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _folder..." Command="{Binding OpenFolderCommand}" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Close tab" Command="{Binding CloseCommand}" />
                <MenuItem Header="Close _all tabs" Command="{Binding CloseAllCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_New">
                <MenuItem Header="Lua _script" Command="{Binding NewLuaScriptCommand}" />
                <MenuItem Header="AI goal _table" Command="{Binding NewLuaInfoCommand}" />
                <MenuItem Header="AI _globals table" Command="{Binding NewLuaGnlCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find" Click="OnFindClick" InputGestureText="Ctrl+F" />
                <Separator />
                <MenuItem Header="Copy whole function" Click="OnCopyFunction" IsEnabled="{Binding ActiveIsEditor}" InputGestureText="Ctrl+Shift+C" />
                <MenuItem Header="Save function as draft..." Click="OnSaveFunctionDraft" IsEnabled="{Binding ActiveIsEditor}" InputGestureText="Ctrl+Shift+D" />
                <MenuItem Header="Function drafts and templates..." Click="OnScriptLibrary" InputGestureText="Ctrl+Shift+L" />
                <Separator />
                <MenuItem Header="Collapse all functions" Click="OnCollapseFunctions" IsEnabled="{Binding ActiveIsEditor}" />
                <MenuItem Header="Expand all functions" Click="OnExpandFunctions" IsEnabled="{Binding ActiveIsEditor}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Reload from bytecode" Command="{Binding ReloadFromBytecodeCommand}" />
                <MenuItem Header="Extract all scripts to folder..." Command="{Binding ExtractAllCommand}" />
                <Separator />
                <MenuItem Header="Check goal table" Command="{Binding ValidateCommand}" />
                <MenuItem Header="Import goals..." Command="{Binding ImportGoalsCommand}" />
                <MenuItem Header="Export goals..." Command="{Binding ExportGoalsCommand}" />
                <Separator />
                <MenuItem Header="_Appearance..." Click="OnAppearanceClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- ===================== Toolbar ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel>
                <TextBlock Text="Game" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding GameModes}" SelectedItem="{Binding GameMode}" Width="68" Margin="0,0,10,0" />
                <Button Content="Open" Style="{StaticResource AccentButton}" Command="{Binding OpenFileCommand}" />
                <Button Content="Open folder" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}" />
                <Border Width="1" Margin="10,2" Background="{StaticResource BrushBorderSubtle}" />
                <Button Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Save as" Margin="6,0,0,0" Command="{Binding SaveAsCommand}" />
                <Border Width="1" Margin="10,2" Background="{StaticResource BrushBorderSubtle}" />
                <Button Content="Open entry" Command="{Binding OpenEntryCommand}" />
                <Button Content="Extract all" Margin="6,0,0,0" Command="{Binding ExtractAllCommand}" />
                <Border Width="1" Margin="10,2" Background="{StaticResource BrushBorderSubtle}" />
                <Button Content="New script" Command="{Binding NewLuaScriptCommand}" />
                <Button Content="New goal table" Margin="6,0,0,0" Command="{Binding NewLuaInfoCommand}" />
                <Button Content="Save function draft" Margin="8,0,0,0" Click="OnSaveFunctionDraft" IsEnabled="{Binding ActiveIsEditor}" />
                <Button Content="Drafts / templates" Margin="6,0,0,0" Click="OnScriptLibrary" />
            </WrapPanel>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding ActiveDetail}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ActiveDetail}" Foreground="{DynamicResource BrushTextMuted}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding ModeCaption}"
                           Margin="18,0,0,0" Foreground="{DynamicResource BrushTextMuted}" />
            </Grid>
        </Border>

        <!-- ===================== Find / replace ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgElevated}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,7"
                Visibility="{Binding ActiveIsEditor, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Find" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" />
                <TextBox x:Name="FindTermBox" Width="190" Margin="8,0,0,0"
                         KeyDown="OnFindTermKeyDown" />
                <CheckBox x:Name="MatchCaseCheckBox" Content="Match case" Margin="10,0,0,0" />
                <Button Content="Next" Margin="10,0,0,0" Style="{StaticResource IconButton}"
                        Click="OnFindNextClick" />
                <TextBlock Text="Replace" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" />
                <TextBox x:Name="ReplaceTermBox" Width="170" Margin="8,0,0,0" />
                <Button Content="Replace" Margin="10,0,0,0" Style="{StaticResource IconButton}"
                        Click="OnReplaceClick" />
                <Button Content="All" Margin="6,0,0,0" Style="{StaticResource IconButton}"
                        Click="OnReplaceAllClick" />
                <TextBlock x:Name="FindStatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}" />
            </StackPanel>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{StaticResource BrushBgPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,12,12,4">
                    <TextBlock Text="RECENT" Style="{StaticResource SectionHeader}" />
                    <!-- No horizontal bar: paths are long, so an Auto horizontal scrollbar appeared under
                         the list for a single line. The text trims instead. -->
                    <ListBox ItemsSource="{Binding RecentFiles}" MaxHeight="96"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnRecentDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,10,12,4">
                    <TextBlock Text="{Binding SymbolsCaption}" Style="{StaticResource SectionHeader}" />
                    <TextBox Text="{Binding SymbolFilter, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                    <TextBlock Text="{Binding SymbolHint}" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>

                <!-- Symbols are long identifiers, so this list also scrolls sideways by default and the
                     text is trimmed with the full name in the tooltip instead. -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Symbols}" Margin="8,0,8,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="OnSymbolDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding}"
                                       FontFamily="Cascadia Mono, Consolas, Courier New" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="12,8,12,12">
                    <TextBlock Text="AI SCRIPT OPTIONS" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Autocomplete while typing" IsChecked="{Binding EnableAutocomplete}"
                              ToolTip="Suggest symbols and script names. Ctrl+Space opens suggestions; Tab or Enter inserts a choice. F12 opens a script definition." />
                    <CheckBox Content="Name AI arguments from .luainfo" IsChecked="{Binding NameAiArgumentsFromGoals}"
                              ToolTip="Replaces generated f1_arg0 style parameters with the real callback parameters (ai, goal, paramTbl) using the goal table found next to the script" />
                    <CheckBox Content="Ignore debug info (recover locals)" IsChecked="{Binding IgnoreDebugInfo}" />
                    <CheckBox Content="Add debug comments" IsChecked="{Binding OutputDebugComments}" />
                    <CheckBox Content="Keep going on pass errors" IsChecked="{Binding CatchPassExceptions}" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BrushBorderSubtle}" />

            <!-- Documents -->
            <TabControl Grid.Column="2" ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument}"
                        Padding="0">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding Detail}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

    </DockPanel>
</Window>
