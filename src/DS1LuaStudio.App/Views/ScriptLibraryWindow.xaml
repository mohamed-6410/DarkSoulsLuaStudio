<Window x:Class="DS1LuaStudio.App.Views.ScriptLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Function drafts and enemy templates" Width="1080" Height="760" MinWidth="850" MinHeight="600"
        Background="{DynamicResource BrushBgDark}" Foreground="{DynamicResource BrushTextPrimary}" FlowDirection="LeftToRight">
    <DockPanel Margin="14" Background="{DynamicResource BrushBgDark}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="DRAFTS &amp; TEMPLATES" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
            <TextBlock Text="Save a complete action once, then adapt it for another enemy or boss." Margin="0,4,0,0" Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource BrushWarning}" Margin="0,0,0,8" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Save draft" Click="OnSaveDraft" Margin="0,0,8,0" />
                <Button Content="Copy source" Click="OnCopy" Margin="0,0,8,0" />
                <Button x:Name="InsertButton" Content="Insert into current script" Click="OnInsert" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                <Button Content="Open as new script" Click="OnNewScript" Margin="0,0,8,0" />
                <Button Content="Close" IsCancel="True" />
            </WrapPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged" ToolTip="Search draft names, notes and source" />
                    <CheckBox x:Name="GameOnlyCheck" Content="Only current game" IsChecked="True" Margin="0,8,0,8" Click="OnGameFilterChanged" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="LibraryPathText" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <ListBox x:Name="LibraryList" DisplayMemberPath="Caption" SelectionChanged="OnSelected"
                         Background="{DynamicResource BrushBgPanel}" BorderBrush="{DynamicResource BrushBorderSubtle}" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8" />
                    <TextBlock Text="Draft name" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBox x:Name="NameBox" Margin="0,4,0,6" />
                    <TextBlock Text="Notes / dependencies to keep" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBox x:Name="NotesBox" Margin="0,4,0,8" />
                    <WrapPanel x:Name="TemplateFields" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="AI base name" Foreground="{DynamicResource BrushTextPrimary}" /><TextBox x:Name="GoalNameBox" Width="200" TextChanged="OnParametersChanged" /></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Act" Foreground="{DynamicResource BrushTextPrimary}" /><TextBox x:Name="ActBox" Width="44" Text="4" TextChanged="OnParametersChanged" /></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Attack ID" Foreground="{DynamicResource BrushTextPrimary}" /><TextBox x:Name="AttackBox" Width="74" Text="3000" TextChanged="OnParametersChanged" /></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Follow-up ID" Foreground="{DynamicResource BrushTextPrimary}" /><TextBox x:Name="FollowupBox" Width="84" Text="3001" TextChanged="OnParametersChanged" /></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Range" Foreground="{DynamicResource BrushTextPrimary}" /><TextBox x:Name="RangeBox" Width="54" Text="3" TextChanged="OnParametersChanged" /></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="Phase HP (0–1)" Foreground="{DynamicResource BrushTextPrimary}" /><TextBox x:Name="PhaseBox" Width="80" Text="0.5" TextChanged="OnParametersChanged" /></StackPanel>
                        <Button Content="Generate preview" Click="OnGeneratePreview" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </WrapPanel>
                    <WrapPanel x:Name="RenameFields" Margin="0,0,0,8">
                        <TextBlock Text="New function name" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" />
                        <TextBox x:Name="RenameBox" Width="250" />
                        <Button Content="Rename in preview" Click="OnRename" Margin="8,0,0,0" />
                    </WrapPanel>
                    <TextBlock Text="Source preview — editable" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                </StackPanel>
                <TextBox x:Name="SourceBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13"
                         FlowDirection="LeftToRight" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
